<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PipeWizard.ViewModels"
             xmlns:views="clr-namespace:PipeWizard.Views"
             x:Class="PipeWizard.App"
             Name="PipeWizard"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

            <!-- PipeWizard palette: dark blue-black panels, pipe green, Mario red. -->
            <Color x:Key="BackgroundColor">#060A0F</Color>
            <Color x:Key="SidebarColor">#0A1017</Color>
            <Color x:Key="SurfaceColor">#101822</Color>
            <Color x:Key="SurfaceAltColor">#0C141D</Color>
            <Color x:Key="SurfaceHoverColor">#16212D</Color>
            <Color x:Key="BorderColor">#1E2A38</Color>
            <Color x:Key="BorderStrongColor">#2B3B4D</Color>
            <Color x:Key="TextColor">#EDF4FC</Color>
            <Color x:Key="TextSecondaryColor">#A3B4C8</Color>
            <Color x:Key="TextMutedColor">#70849B</Color>
            <Color x:Key="AccentColor">#37C871</Color>
            <Color x:Key="AccentHoverColor">#4BDC85</Color>
            <Color x:Key="AccentSoftColor">#123122</Color>
            <Color x:Key="OnAccentColor">#04140A</Color>
            <Color x:Key="RedColor">#E23B32</Color>
            <Color x:Key="RedHoverColor">#F04A41</Color>
            <Color x:Key="WarningColor">#F0B84B</Color>
            <Color x:Key="SuccessColor">#45D483</Color>
            <Color x:Key="NavSelectedColor">#112A1D</Color>
            <Color x:Key="DangerSoftColor">#2A1414</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
            <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource RedHoverColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#162A1D" />
                <GradientStop Offset="0.55" Color="#0E1A18" />
                <GradientStop Offset="1" Color="#0A1018" />
            </LinearGradientBrush>

            <!-- Fluent accent, so toggles, focus rings and selection follow the pipe green. -->
            <Color x:Key="SystemAccentColor">#37C871</Color>
            <Color x:Key="SystemAccentColorDark1">#2DA85F</Color>
            <Color x:Key="SystemAccentColorDark2">#24894D</Color>
            <Color x:Key="SystemAccentColorDark3">#1B6C3C</Color>
            <Color x:Key="SystemAccentColorLight1">#55DC8B</Color>
            <Color x:Key="SystemAccentColorLight2">#7BE9A7</Color>
            <Color x:Key="SystemAccentColorLight3">#A6F3C5</Color>

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2DA85F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1A2532" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#2B3B4D" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />

            <!-- Material-style 24x24 geometry, used through PathIcon. -->
            <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
            <StreamGeometry x:Key="IconMods">M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z</StreamGeometry>
            <StreamGeometry x:Key="IconLibrary">M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
            <StreamGeometry x:Key="IconExternal">M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconUp">M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z</StreamGeometry>
            <StreamGeometry x:Key="IconDown">M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z</StreamGeometry>
            <StreamGeometry x:Key="IconLeft">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</StreamGeometry>
            <StreamGeometry x:Key="IconRight">M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
            <StreamGeometry x:Key="IconGamepad">M21.58 16.09l-1.09-7.66C20.21 6.46 18.52 5 16.53 5H7.47C5.48 5 3.79 6.46 3.51 8.43l-1.09 7.66C2.2 17.63 3.39 19 4.94 19c.68 0 1.32-.27 1.8-.75L9 16h6l2.25 2.25c.48.48 1.13.75 1.8.75 1.56 0 2.75-1.37 2.53-2.91zM11 11H9v2H8v-2H6v-1h2V8h1v2h2v1zm4-1c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PipeWizard/Styles/AppStyles.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:ModsViewModel">
            <views:ModsView />
        </DataTemplate>
        <DataTemplate DataType="vm:InstalledViewModel">
            <views:InstalledView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
